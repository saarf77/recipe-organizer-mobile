{
  "expo": {
    "name": "Recipe Organizer",
    "slug": "recipe-organizer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F97316"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recipeorganizer.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to capture recipe photos",
        "NSPhotoLibraryUsageDescription": "Used to select recipe images",
        "NSPhotoLibraryAddUsageDescription": "Used to save recipe images"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F97316"
      },
      "package": "com.recipeorganizer.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Recipe Organizer to access your camera."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Recipe Organizer to access your photos."
        }
      ],
      "expo-asset",
      "expo-sqlite"
    ],
    "scheme": "recipeorganizer",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
